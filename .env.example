# 填写后可接入真实 OAuth 与 CloudBase；切勿提交 .env.local。
CLOUDBASE_ENV_ID=
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
SESSION_ENCRYPTION_KEY=
APP_URL=http://localhost:3000
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# 兼容旧配置：LLM_PROVIDER=deepseek 且未设置 LLM_API_KEY 时使用以下变量
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
