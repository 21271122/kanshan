{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-oauth-check/types/**/*.ts",
    ".next-verify-fav/types/**/*.ts",
    ".next-revert/types/**/*.ts",
    ".next-asset-qa/types/**/*.ts",
    ".next-asset-qa2/types/**/*.ts",
    ".next-asset-qa3/types/**/*.ts",
    ".next-final-qa/types/**/*.ts",
    ".next-fertilizer-qa/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
